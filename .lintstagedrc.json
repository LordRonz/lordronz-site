{
  "src/**/*.{js,jsx,ts,tsx}": [
    "oxlint --deny-warnings",
    "oxfmt --no-error-on-unmatched-pattern"
  ],
  "src/**/*.{json,css,scss,md,mdx}": ["oxfmt --no-error-on-unmatched-pattern"],
  "./**/*.{js,ts,md,json,yml,yaml,html}": [
    "oxfmt --no-error-on-unmatched-pattern"
  ],
  "src/**/*.css": ["stylelint"],
  "package.json": ["sort-package-json"]
}
