{
  "name": "lordronz-site",
  "version": "0.0.5",
  "private": true,
  "author": {
    "name": "lordronz",
    "url": "https://www.aaronct.dev"
  },
  "scripts": {
    "prebuild": "bun ./src/scripts/runner.ts",
    "build": "bun run --bun next build",
    "postbuild": "next-sitemap",
    "build-ci": "cross-env CI=true bun run build",
    "build-prod": "cross-env NODE_ENV=production next build",
    "build-stats": "cross-env ANALYZE=true bun run build",
    "build-storybook": "cross-env TS_NODE_PROJECT=.storybook/tsconfig.json storybook build",
    "clean": "rimraf .next out",
    "clean:nodemodules": "rimraf node_modules",
    "coverage:coveralls": "vitest run --coverage && coveralls < coverage/lcov.info",
    "create-blog": "bun ./src/scripts/blog.ts -b",
    "deduplicate": "npx yarn-deduplicate && yarn install",
    "dev": "bun run --bun next dev",
    "dev:webpack": "next dev",
    "export": "next export",
    "find-unused": "bun ./src/scripts/find-unused.ts",
    "fix-all": "concurrently \"bun run lint:fix\" \"bun run test\" \"bun run tsc\" \"bun run stylelint:fix\"",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "gcp-build": "next build",
    "preinstall": "npx only-allow bun -y",
    "lint": "oxlint . && oxfmt --check \"**/*.{js,jsx,ts,tsx,mjs}\"",
    "lint:fix": "oxlint . --fix && bun run format",
    "lint:package": "sort-package-json",
    "lint:strict": "oxlint src --deny-warnings",
    "lint-staged": "lint-staged",
    "list-blog": "bun ./src/scripts/blog.ts -l",
    "prepare": "husky",
    "release": "commit-and-tag-version",
    "scan": "npx react-scan@latest localhost:3000",
    "start": "next start",
    "storybook": "cross-env TS_NODE_PROJECT=.storybook/tsconfig.json cross-env BROWSER=none storybook dev -p 6006 -h localhost",
    "stylelint": "stylelint \"**/*.css\"",
    "stylelint:fix": "bun run stylelint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test-all": "run-s test",
    "tsc": "tsc --pretty --noEmit --incremental false",
    "vitest": "vitest"
  },
  "resolutions": {
    "@grpc/grpc-js": "^1.14.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jackspeak": "2.1.1",
    "webpack": "^5"
